# Copy this file to .env and fill it in. Never commit .env or share it.

# The public address of the site, no trailing slash
PUBLIC_URL=https://primebaking.co.zw

# development while testing on your computer; production for the live shop
NODE_ENV=development
PORT=3000
# Exact number of proxies in front of the app: 1 on Render/Railway/most hosts, 2 if you also use Cloudflare, 0 if none
TRUST_PROXY=1
